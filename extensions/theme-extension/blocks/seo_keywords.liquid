{%- if template.name == 'product' and product.metafields.seo.keywords.value != blank -%}
  {%- assign seo_kw = product.metafields.seo.keywords.value -%}
  {%- if seo_kw.first -%}
    <meta name="keywords" content="{{ seo_kw | join: ', ' | strip | escape }}">
  {%- else -%}
    <meta name="keywords" content="{{ seo_kw | strip | escape }}">
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "SEO Keywords Tag",
  "target": "head",
  "settings": []
}
{% endschema %}
