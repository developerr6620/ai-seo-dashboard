{%- assign is_active = true -%}
{%- if template.name == 'product' and block.settings.enable_products == false -%}
  {%- assign is_active = false -%}
{%- elsif template.name == 'page' and block.settings.enable_pages == false -%}
  {%- assign is_active = false -%}
{%- elsif template.name == 'collection' and block.settings.enable_collections == false -%}
  {%- assign is_active = false -%}
{%- elsif template.name == 'article' and block.settings.enable_articles == false -%}
  {%- assign is_active = false -%}
{%- elsif template.name == 'index' and block.settings.enable_home == false -%}
  {%- assign is_active = false -%}
{%- endif -%}

{%- if is_active -%}
  {%- assign seo_kw = blank -%}
  {%- if template.name == 'product' or template contains 'product' -%}
    {%- assign seo_kw = product.metafields.seo.keywords.value | default: product.metafields.seo.keywords -%}
  {%- elsif template.name == 'collection' or template contains 'collection' -%}
    {%- assign seo_kw = collection.metafields.seo.keywords.value | default: collection.metafields.seo.keywords -%}
  {%- elsif template.name == 'page' or template contains 'page' -%}
    {%- assign seo_kw = page.metafields.seo.keywords.value | default: page.metafields.seo.keywords -%}
  {%- elsif template.name == 'article' or template contains 'article' -%}
    {%- assign seo_kw = article.metafields.seo.keywords.value | default: article.metafields.seo.keywords -%}
  {%- elsif template.name == 'index' or template == 'index' -%}
    {%- assign seo_kw = shop.metafields.seo.keywords.value | default: shop.metafields.seo.keywords -%}
  {%- endif -%}

  {%- comment -%} Universal fallback if template variable was different {%- endcomment -%}
  {%- if seo_kw == blank -%}
    {%- if product != blank and product.metafields.seo.keywords != blank -%}
      {%- assign seo_kw = product.metafields.seo.keywords.value | default: product.metafields.seo.keywords -%}
    {%- elsif collection != blank and collection.metafields.seo.keywords != blank -%}
      {%- assign seo_kw = collection.metafields.seo.keywords.value | default: collection.metafields.seo.keywords -%}
    {%- elsif page != blank and page.metafields.seo.keywords != blank -%}
      {%- assign seo_kw = page.metafields.seo.keywords.value | default: page.metafields.seo.keywords -%}
    {%- elsif article != blank and article.metafields.seo.keywords != blank -%}
      {%- assign seo_kw = article.metafields.seo.keywords.value | default: article.metafields.seo.keywords -%}
    {%- endif -%}
  {%- endif -%}

  {%- if seo_kw != blank -%}
    {%- if seo_kw.first -%}
      <meta name="keywords" content="{{ seo_kw | join: ', ' | strip | escape }}">
    {%- else -%}
      <meta name="keywords" content="{{ seo_kw | strip | escape }}">
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "AI SEO Suite (All-In-One)",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "One master toggle to activate SEO keywords & search tags across your entire store (Products, Pages, Collections & Blogs)."
    },
    {
      "type": "checkbox",
      "id": "enable_products",
      "label": "Enable on Product Pages",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_pages",
      "label": "Enable on Online Store Pages",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_collections",
      "label": "Enable on Collection Pages",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_articles",
      "label": "Enable on Blog Articles",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_home",
      "label": "Enable on Homepage",
      "default": true
    }
  ]
}
{% endschema %}
